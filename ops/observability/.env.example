# Copy to ops/observability/.env and fill in. `.env` is gitignored by contract and must NEVER be
# committed. This file carries VARIABLE NAMES ONLY — never a real value, not even an "example"
# one that looks real.
#
# Note for anyone adding a variable here: the repo's own scanner (scripts/check-secrets.mjs)
# only matches QUOTED credential literals, so an unquoted assignment would slip past it entirely
# and the first backstop would be gitleaks, which runs remote-only. Keep values out of this file
# rather than relying on a scanner to catch them. (This file is itself scanned by
# checks/stack-config-checks.redteam.test.mjs, which is case-insensitive and covers the
# unquoted form — including, deliberately, bcrypt hashes.)

# Absolute path to the SpacetimeDB data directory whose replicas/*/module_logs/*.log Alloy tails
# READ-ONLY (OBS-11/OBS-45). Typically ~/.local/share/spacetime/data.
MR_SPACETIME_DATA_DIR=

# Grafana admin password. Required — the stack refuses to start without it rather than silently
# booting an admin/admin instance.
GF_SECURITY_ADMIN_PASSWORD=

# Where Grafana unified alerting sends notifications. Required — an alerting stack whose contact
# point notifies nobody is the exact D4 failure this design exists to prevent. A self-hosted ntfy
# topic URL is the intended value; any webhook receiver works.
MR_ALERT_WEBHOOK_URL=

# Caddy basic-auth credentials for the operator-only Grafana route (OBS-20).
# Generate the hash with:  docker compose run --rm --entrypoint caddy caddy hash-password
MR_GRAFANA_BASIC_AUTH_USER=operator
MR_GRAFANA_BASIC_AUTH_HASH=

# Origin allowed to POST browser telemetry to the public OTLP ingest route (OBS-21). Browser
# enforced only — see the Caddyfile header for why this is not the control against a scripted
# client. Defaults to the Vite dev origin.
MR_OTLP_ALLOWED_ORIGIN=https://localhost:5173
