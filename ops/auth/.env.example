# Copy to .env beside docker-compose.yml (git ignores .env) and fill in what your profile needs.
# local-dev and hosted-dev need nothing here: their issuers are fixed, and their keys live on
# volumes (docs/runbooks/account-service.md).

# local-dev: the host port Caddy publishes on 127.0.0.1. The issuer stays http://localhost:4455,
# so a browser or a game client needs the default.
# MR_AUTH_LOCAL_PORT=4455

# production: the issuer every release module trusts, a bare https origin; Caddy serves it.
# MR_ACCOUNT_ISSUER=https://accounts.example.com
