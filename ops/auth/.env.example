# Better Auth issuer — environment template (ADR-0182 D18).
#
# Copy to `.env` (gitignored, NEVER committed) and replace every value. The
# placeholders below are gitleaks-safe: credential-shaped values use the
# INTERNAL_SECRET_ prefix (.gitleaks.toml allowlist) so the scanner does not
# flag this template, while a REAL secret pasted here still trips the scan.

# Session/cookie signing secret for Better Auth itself (NOT the JWKS signing key
# — that lives in a file, see JWKS_PRIVATE_KEY_PATH). Generate 32+ random bytes.
BETTER_AUTH_SECRET=INTERNAL_SECRET_REPLACE_WITH_32B_RANDOM

# The public HTTPS origin of the issuer — OQ4: a dedicated SUBDOMAIN of the
# game's own domain (for the safer SameSite=Lax cookie posture). This exact URL
# becomes the module's ALLOWED_ISSUERS value at the deployment-timed follow-up
# (13r-c-2-gated — NOT part of the M21b-2 client slice; see README §Sequencing).
BETTER_AUTH_URL=https://auth.example-monster-realm.invalid

# The OAuth client_id from `auth.api.adminCreateOAuthClient(...)` (server-side,
# public client, token_endpoint_auth_method=none, PKCE). This exact value becomes
# the module's ALLOWED_AUDIENCE — a single entry, never a list (CRITICAL-2/D18).
OAUTH_CLIENT_ID=INTERNAL_SECRET_REPLACE_WITH_CLIENT_ID

# SQLite database path inside the container (backed up by the runbook §8 sweep).
DATABASE_PATH=/var/lib/better-auth/auth.sqlite

# JWKS signing-key material, held OUTSIDE the database and OUTSIDE the routine
# restic sweep (D20 signing-key custody). A separate, narrowly-scoped secret.
JWKS_PRIVATE_KEY_PATH=/run/secrets/jwks.key
