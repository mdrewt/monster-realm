// Shop registry — DATA, not code (ADR-0006). Stable `id`s are APPEND-ONLY.
// buy_price: cost in currency to buy the item; 0 = not for sale (item listed but buyable=false).
// sell_price for items lives on ItemDef (game-core/content/items/000-core.ron), not per-shop.
[
    (
        id: 1,
        name: "Pebble Town Shop",
        stock: [
            ( item_id: 1, buy_price: 200 ),
            ( item_id: 2, buy_price: 300 ),
            // Antidote (pt-d3, ADR-0145 D5). Stocked because the playtest roster
            // gained two WILD-LEGAL Poison appliers (Shadelet and Umbraquill both
            // know Toxic Sting), and this item was previously sold by no shop and
            // granted by no quest — a status the player can suffer with no
            // purchasable cure. 150 is derived, not picked: the two entries above
            // both sit at sell = 40% of buy (80/200, 120/300) and this item's
            // sell_price is 60, so 150 preserves that convention. ~5 wild wins
            // at the unchanged 31-32 gold faucet.
            ( item_id: 3, buy_price: 150 ),
            // Crystalized-essence consumables (EG3-6, ADR-0176 D6). Both sell
            // at 200, so 500 is the 40% convention every entry above follows
            // (80/200, 120/300, 60/150). Each grants exactly the essence its
            // item-assisted evolution edge requires, so one purchase is one
            // guaranteed branch unlock rather than a lottery ticket.
            //
            // These become consumable when consume_crystalized_essence (EG2-4)
            // lands in the sibling slice; until it merges they are buyable but
            // inert, which is why the price is high enough not to be an
            // impulse buy. See ADR-0176 D6.
            ( item_id: 4, buy_price: 500 ),
            ( item_id: 5, buy_price: 500 ),
        ],
    ),
]
