// Zone map registry — DATA, not code. String-art tile rows
// + warp list, keyed by zone_id. Tile glyphs (game-core TileKind::from_char):
//   walkable:  '.' floor   '~' tall grass (wild encounters)   '=' path   ':' sand
//   blocking:  '#' wall    'w' shallow water   'W' deep water   '^' rock   'T' tree   '*' bush
// Deep water may border only water (validate_zone_maps check 1b) — the shore band is shallow's.
// Warps are stored as an overlay list (not a tile glyph).
// zone_id MUST exist in the zones registry (content/zones/). APPEND-ONLY ids.
[
    (
        zone_id: 0,
        // Verdant Hollow (wap-8): 28x20. The original 10x7 village block (x=0..9, y=0..6) is kept
        // tile-for-tile except two tiles: (8,3), the heal tile, is path (it was tall grass, so
        // stepping onto the healer rolled encounters), and (3,6) opens the south wall onto a
        // trail into the meadow, lake and copse grown south and east. (3,6) is Manhattan 3 from
        // elder_oak's home (5,5), outside his radius-2 wander disc; the bush at (5,7) keeps the disc's
        // only tile south of the wall out of it (npc_decide coverage test). Rows 0-6 beyond x=9 are a
        // tree, rock and pond belt, so (9,1) and the block's east wall stay blocked.
        rows: [
            "##########TTTTTTTTTTTTTTTTTT",
            "#........#TT^^TTTTT**TTTTTTT",
            "#.~~....~#T^wwwTTTT*TTT^^TTT",
            "#...##..=#TwwwwwTTTTTTTT^TTT",
            "#..~~...~#TTwwwTT*TTTTTTTTTT",
            "#......~~#TTTTTTTTT^^TTTTTTT",
            "###=######TTTTTT**TTTTTTTTTT",
            "T..=.*..~~~...TTT.....*..^TT",
            "T..=...~~~~~..TT....~~~...TT",
            "T*.=....~~~.......~~~~~~..*T",
            "T..==========.....~~~~.....T",
            "T.....^.....=====......^^..T",
            "TT..wwww.........=.....TT..T",
            "T..wwwwww..~~~...=....TTT..T",
            "T..wwwwww.~~~~~..=*........T",
            "T...wwww..~~~~...======....T",
            "T*.......^..~~.....^...=...T",
            "TT....TT.......**.....===..T",
            "TTT...TTT..^.........^....TT",
            "TTTTTTTTTTTTTTTTTTTTTTTTTTTT",
        ],
        warps: [
            // (1,5) in zone 0 is '.' (floor) — walkable warp to Tideglass Cove. Off elder_oak's
            // home (5,5) and outside its wander disc, and not the heal tile (8,3) (qf-15).
            (from: (x: 1, y: 5), to_zone: 1, to_tile: (x: 1, y: 5)),
        ],
    ),
    (
        zone_id: 1,
        // Tideglass Cove (wap-7): 32x20 coast — village lane and meadow in the north-west,
        // a sand beach running south-west to north-east, and a deep bay to the south-east.
        // Anchors kept walkable and grass-free for the e2e routes: column x=1 (y=1..5),
        // row y=1 (x=1..8), row y=5 (x=1..6), column x=6 (y=1..5). The shopkeeper's home
        // (8,1) is reachable only from its post (7,1): (8,0) wall, (9,1) and (8,2) rock.
        // (0,5) stays wall (sim-harness bumps West into it from the landing).
        rows: [
            "################################",
            "#........^~~~~~....TT..~~~~~TTT#",
            "#.~~..=.^^~~~~~....TT..~~~~~~TT#",
            "#...^^=.....~~.........~~~~~..T#",
            "#..~..=..*.......=====......*.T#",
            "#.....=.~~~......=...........TT#",
            "#.T...=.~~~~.....=..^^......::::",
            "#.....===========.....::::::::ww",
            "#....TT....=....::::^^:::wwwwwww",
            "#.~~~......=...::::wwwwwwwwwwwww",
            "#.~~~~.....=..:::wwwwWWWWWWWWWWW",
            "#..~~...:::=:::wwwwWWWWWWWWWWWWW",
            "#...TT..:::=::wwwwWWWWWWWWWWWWWW",
            "#.^....::::=:wwwwWWWWWWWWWWWWWWW",
            "#....::::^:=:wwwwwwWWWWWWWWWWWWW",
            "#..:::::::::wwww^wwwWWWWWWWWWWWW",
            "#:::::^:wwwwwwwwwwwwWWWWWWWWWWWW",
            "#::wwwwwwwwwwWWWWWWWWWWWWWWWWWWW",
            "#wwwwwwWWWWWWWWWWWWWWWWWWWWWWWWW",
            "#wwwwwwWWWWWWWWWWWWWWWWWWWWWWWWW",
        ],
        warps: [
            // Return warp from Tideglass Cove back to Verdant Hollow.
            // (1,5) in zone 1 is '.' (floor) — walkable; not the shopkeeper's home (8,1).
            (from: (x: 1, y: 5), to_zone: 0, to_tile: (x: 1, y: 5)),
        ],
    ),
]
