# Normalize line endings to LF so shell scripts/justfiles work on Linux CI.
* text=auto eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff2 binary
*.pdf binary
*.wasm binary

# The vendored crates are hashed byte for byte (vendor/PRISTINE.sha256): no line-ending
# normalisation may touch them.
vendor/** -text
